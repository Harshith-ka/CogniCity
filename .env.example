# Application
APP_NAME=ai-twin-city
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://city_user:city_pass@localhost:5432/ai_twin_city

# Redis
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_pass

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM Configuration — choose one provider
# Options: openai, anthropic, ollama
LLM_PROVIDER=ollama

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Ollama (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Override embedding dimension (0 = auto-detect from provider)
# openai=1536, ollama/nomic-embed-text=768
EMBEDDING_DIM=0

# Simulation
SIMULATION_TICK_SECONDS=1.0
SIMULATION_TIME_SCALE=60
INITIAL_POPULATION=100
MAX_POPULATION=10000

# Seed
RANDOM_SEED=42

# ══════════════════════════════════════════════════════════════════════
# Security — REQUIRED overrides outside APP_ENV=development.
# The app refuses to start with any of these left at their (insecure)
# defaults once APP_ENV isn't "development" — see
# backend/app/core/config.py:_validate_production_config().
# ══════════════════════════════════════════════════════════════════════

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-before-any-real-deployment
JWT_EXPIRE_MINUTES=1440

# Seeded on first boot only — rotate immediately if this DB was ever seeded
# with the default below, since that admin account already exists in it.
INITIAL_ADMIN_EMAIL=admin@cognicity.local
INITIAL_ADMIN_PASSWORD=changeme123

# Comma-separated browser origins allowed to call this API with credentials.
# "*" is only accepted in development — CORS doesn't apply to server-side
# callers (Streamlit, native mobile), only to browser clients like the Expo
# web build or a future standalone web frontend.
CORS_ALLOWED_ORIGINS=*

# Requests/minute per client IP on POST /api/auth/login and /api/auth/signup.
AUTH_RATE_LIMIT_PER_MINUTE=10
